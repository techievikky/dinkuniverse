# Google OAuth client ID from Google Cloud Console.
# Add every local and production frontend origin to Google's authorized origins.
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Supabase Postgres connection string. Keep this server-side; do not prefix it with VITE_.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
NODE_ENV=development
PORT=4100
APP_ORIGIN=http://localhost:5173

# Comma-separated emails that should bootstrap as admins.
ADMIN_EMAILS=admin@example.com

# Stripe secret key (server-side) and webhook signing secret, from the Stripe dashboard.
# Required for tournament entry-fee checkout; leave unset to disable paid registration.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
